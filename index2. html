<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task and Note Manager - Pro</title>
    <style>
        :root {
            --bg-color: #121212;
            --surface-color: #1e1e1e;
            --primary-color: #bb86fc;
            --text-color: #e0e0e0;
            --text-secondary: #a0a0a0;
            --border-color: #2c2c2c;
            --danger-color: #cf6679;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }
        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            padding: 16px;
            max-width: 600px;
            margin: 0 auto;
        }
        h1 {
            text-align: center;
            color: var(--primary-color);
            margin-bottom: 20px;
            font-size: 24px;
        }
        .tabs {
            display: flex;
            background: var(--surface-color);
            border-radius: 8px;
            padding: 4px;
            margin-bottom: 20px;
            border: 1px solid var(--border-color);
        }
        .tab-btn {
            flex: 1;
            background: none;
            border: none;
            color: var(--text-secondary);
            padding: 10px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 6px;
            transition: 0.2s;
        }
        .tab-btn.active {
            background: var(--primary-color);
            color: #000;
        }
        .view {
            display: none;
        }
        .view.active {
            display: block;
        }
        .card {
            background: var(--surface-color);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 16px;
        }
        input, textarea, select {
            width: 100%;
            background: #2c2c2c;
            border: 1px solid var(--border-color);
            color: var(--text-color);
            padding: 10px;
            border-radius: 6px;
            margin-bottom: 10px;
            font-size: 14px;
        }
        button.primary {
            background: var(--primary-color);
            color: #000;
            border: none;
            padding: 10px 16px;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            width: 100%;
        }
        .item-list {
            list-style: none;
            margin-top: 10px;
        }
        .item-list li {
            background: #252525;
            border: 1px solid var(--border-color);
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .item-info {
            flex: 1;
        }
        .item-actions button {
            background: var(--danger-color);
            color: #fff;
            border: none;
            padding: 6px 10px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
        }
    </style>
</head>
<body>

    <h1>Task & Note Manager Pro</h1>

    <div class="tabs">
        <button class="tab-btn active" onclick="switchTab('tasks')">Tasks</button>
        <button class="tab-btn tab-btn-notes" onclick="switchTab('notes')">Notes</button>
    </div>

    <!-- Tasks View -->
    <div id="tasks-view" class="view active">
        <div class="card">
            <h3>Add New Task</h3>
            <input type="text" id="task-title" placeholder="Task title...">
            <input type="datetime-local" id="task-time">
            <button class="primary" onclick="addTask()">Save Task</button>
        </div>
        <div class="card">
            <h3>Your Tasks</h3>
            <ul id="task-list" class="item-list"></ul>
        </div>
    </div>

    <!-- Notes View -->
    <div id="notes-view" class="view">
        <div class="card">
            <h3>Add New Note</h3>
            <input type="text" id="note-title" placeholder="Note title...">
            <textarea id="note-content" rows="4" placeholder="Write your note here..."></textarea>
            <button class="primary" onclick="addNote()">Save Note</button>
        </div>
        <div class="card">
            <h3>Your Notes</h3>
            <ul id="note-list" class="item-list"></ul>
        </div>
    </div>

    <script>
        function switchTab(tab) {
            document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            if(tab === 'tasks') {
                document.getElementById('tasks-view').classList.add('active');
                document.querySelector('.tab-btn').classList.add('active');
            } else {
                document.getElementById('notes-view').classList.add('active');
                document.querySelectorAll('.tab-btn')[1].classList.add('active');
            }
        }

        let tasks = JSON.parse(localStorage.getItem('tasks')) || [];
        let notes = JSON.parse(localStorage.getItem('notes')) || [];

        function render() {
            const taskList = document.getElementById('task-list');
            taskList.innerHTML = '';
            tasks.forEach((t, i) => {
                taskList.innerHTML += `<li>
                    <div class="item-info"><strong>${t.title}</strong><br><small>${t.time || ''}</small></div>
                    <div class="item-actions"><button onclick="deleteTask(${i})">Delete</button></div>
                </li>`;
            });

            const noteList = document.getElementById('note-list');
            noteList.innerHTML = '';
            notes.forEach((n, i) => {
                noteList.innerHTML += `<li>
                    <div class="item-info"><strong>${n.title}</strong><br><small>${n.content}</small></div>
                    <div class="item-actions"><button onclick="deleteNote(${i})">Delete</button></div>
                </li>`;
            });
        }

        function addTask() {
            const title = document.getElementById('task-title').value;
            const time = document.getElementById('task-time').value;
            if(!title) return alert('Please enter task title');
            tasks.push({title, time});
            localStorage.setItem('tasks', JSON.stringify(tasks));
            document.getElementById('task-title').value = '';
            document.getElementById('task-time').value = '';
            render();
        }

        function addNote() {
            const title = document.getElementById('note-title').value;
            const content = document.getElementById('note-content').value;
            if(!title) return alert('Please enter note title');
            notes.push({title, content});
            localStorage.setItem('notes', JSON.stringify(notes));
            document.getElementById('note-title').value = '';
            document.getElementById('note-content').value = '';
            render();
        }

        function deleteTask(i) {
            tasks.splice(i, 1);
            localStorage.setItem('tasks', JSON.stringify(tasks));
            render();
        }

        function deleteNote(i) {
            notes.splice(i, 1);
            localStorage.setItem('notes', JSON.stringify(notes));
            render();
        }

        render();
    </script>
</body>
</html>


