
<!DOCTYPE html>
<html lang="ne">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>कार्य र नोट प्रबन्धक - Pro</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, Roboto, sans-serif; }
        body { background-color: #0b1120; color: #f8fafc; padding: 14px; padding-bottom: 70px; }
        .header { text-align: center; padding: 14px 0; border-bottom: 2px solid #1e293b; margin-bottom: 18px; }
        .header h1 { color: #38bdf8; font-size: 22px; font-weight: 700; }
        
        #alarmAlert { display: none; background: linear-gradient(135deg, #ef4444, #dc2626); color: white; padding: 16px; border-radius: 12px; text-align: center; margin-bottom: 18px; box-shadow: 0 0 25px rgba(239, 68, 68, 0.7); animation: pulse 1s infinite; position: fixed; top: 10px; left: 10px; right: 10px; z-index: 9999; }
        @keyframes pulse { 0% { transform: scale(1); } 50% { transform: scale(1.02); } 100% { transform: scale(1); } }
        .stop-btn { background-color: white; color: #ef4444; border: none; padding: 10px 24px; font-size: 16px; font-weight: bold; border-radius: 8px; cursor: pointer; margin-top: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.3); }

        .card { background-color: #1e293b; padding: 16px; border-radius: 12px; border: 1px solid #334155; margin-bottom: 18px; box-shadow: 0 4px 10px rgba(0,0,0,0.4); }
        .card h2 { font-size: 17px; color: #38bdf8; margin-bottom: 12px; border-bottom: 1px solid #334155; padding-bottom: 6px; }

        label { display: block; margin-top: 10px; font-size: 13px; color: #94a3b8; }
        input[type="text"], textarea, input[type="file"] { width: 100%; padding: 10px; margin-top: 5px; background-color: #0f172a; border: 1px solid #334155; color: white; border-radius: 8px; font-size: 14px; }
        
        .datetime-group {
            display: grid;
            grid-template-columns: 1.2fr 1fr 1fr 1fr;
            gap: 6px;
            margin-top: 5px;
        }
        .datetime-group select, .datetime-group input {
            width: 100%;
            padding: 10px 4px;
            background-color: #0f172a;
            border: 1px solid #334155;
            color: white;
            border-radius: 8px;
            font-size: 13px;
            text-align: center;
        }

        textarea { height: 75px; resize: vertical; }

        .btn { background: linear-gradient(135deg, #0284c7, #0369a1); color: white; border: none; padding: 12px; font-size: 15px; font-weight: bold; border-radius: 8px; cursor: pointer; width: 100%; margin-top: 14px; }
        .perm-btn { background: #f59e0b; color: #000; border: none; padding: 10px 12px; border-radius: 6px; font-weight: bold; font-size: 13px; cursor: pointer; margin-bottom: 12px; width: 100%; box-shadow: 0 2px 5px rgba(0,0,0,0.2); }

        .visiting-card {
            background: linear-gradient(135deg, #1e293b, #0f172a);
            border: 1px solid #38bdf8;
            border-left: 6px solid #38bdf8;
            border-radius: 12px;
            padding: 14px;
            margin-bottom: 14px;
            box-shadow: 0 6px 15px rgba(0,0,0,0.4);
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .visiting-card.completed {
            border-color: #16a34a;
            border-left-color: #16a34a;
            opacity: 0.75;
        }

        .card-main {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .avatar-box {
            width: 65px;
            height: 65px;
            min-width: 65px;
            border-radius: 50%;
            border: 2px solid #38bdf8;
            overflow: hidden;
            background: #090d16;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .completed .avatar-box { border-color: #16a34a; }
        .avatar-img { width: 100%; height: 100%; object-fit: cover; }
        .avatar-placeholder { font-size: 28px; color: #64748b; }

        .card-details { flex-grow: 1; display: flex; flex-direction: column; gap: 4px; }
        .card-title-row { display: flex; align-items: center; gap: 8px; }
        .card-checkbox { width: 20px; height: 20px; cursor: pointer; }
        .card-title { font-size: 16px; font-weight: 700; color: #ffffff; word-break: break-word; }
        .completed .card-title { text-decoration: line-through; color: #94a3b8; }
        .card-alarm { font-size: 12px; color: #fbbf24; font-weight: 500; }
        .card-note-text { font-size: 13px; color: #cbd5e1; background: #0f172a; padding: 6px 8px; border-radius: 6px; border: 1px solid #1e293b; margin-top: 4px; white-space: pre-wrap; }

        .card-actions { display: flex; gap: 8px; justify-content: flex-end; border-top: 1px solid #334155; padding-top: 8px; }
        .action-btn { padding: 5px 12px; font-size: 12px; border-radius: 6px; border: none; cursor: pointer; font-weight: 600; }
        .btn-edit { background-color: #fbbf24; color: #1e1b4b; }
        .btn-delete { background-color: #ef4444; color: white; }

        .backup-section { display: flex; gap: 10px; margin-top: 10px; }
        .backup-section button { flex: 1; padding: 10px; font-size: 12px; background-color: #0f172a; color: #cbd5e1; border: 1px solid #334155; border-radius: 8px; cursor: pointer; }
    </style>
</head>
<body>

    <div id="alarmAlert">
        <h3 id="alarmText">🔔 अलार्म बजिरहेको छ!</h3>
        <p id="alarmSubText" style="margin-top:4px; font-size: 15px;"></p>
        <button class="stop-btn" onclick="stopAlarm()">🔕 अलार्म बन्द गर्नुहोस्</button>
    </div>

    <div class="header">
        <h1>कार्य र नोट प्रबन्धक - Pro</h1>
    </div>

    <div class="card">
        <button class="perm-btn" onclick="requestNotificationPermission()">🔔 नटिफिकेसन अनुमति दिनुहोस्</button>
        <h2 id="formTitle">नयाँ काम थप्नुहोस्</h2>
        <label>कामको नाम (Task Name):</label>
        <input type="text" id="taskInput" placeholder="जस्तै: बजार जाने...">

        <label>थप नोट (Task Description / Note):</label>
        <textarea id="taskNoteInput" placeholder="विस्तृत नोट लेख्नुहोस् (Optional)..."></textarea>

        <label>अलार्म समय (12-Hour Format):</label>
        <div class="datetime-group">
            <input type="date" id="alarmDate">
            <select id="alarmHour">
                <option value="1">1</option><option value="2">2</option><option value="3">3</option>
                <option value="4">4</option><option value="5">5</option><option value="6">6</option>
                <option value="7">7</option><option value="8">8</option><option value="9">9</option>
                <option value="10">10</option><option value="11">11</option><option value="12">12</option>
            </select>
            <select id="alarmMinute">
                <option value="00">00</option><option value="05">05</option><option value="10">10</option>
                <option value="15">15</option><option value="20">20</option><option value="25">25</option>
                <option value="30">30</option><option value="35">35</option><option value="40">40</option>
                <option value="45">45</option><option value="50">50</option><option value="55">55</option>
            </select>
            <select id="alarmAmPm">
                <option value="AM">AM</option>
                <option value="PM">PM</option>
            </select>
        </div>

        <label style="margin-top:12px;">फोटो अट्याच गर्नुहोस् (Photo):</label>
        <input type="file" id="fileInput" accept="image/*">

        <button class="btn" id="saveTaskBtn" onclick="saveTask()">थप्नुहोस् (Add Task)</button>
    </div>

    <div class="card">
        <h2>तपाईंको कामहरू (Visiting Card Layout)</h2>
        <div id="taskList"></div>
    </div>

    <div class="card">
        <h2>डाटा सेभ र ब्याकअप</h2>
        <div class="backup-section">
            <button onclick="exportData()">📥 ब्याकअप डाउनलोड</button>
            <button onclick="document.getElementById('importFile').click()">📤 फाइल लोड</button>
        </div>
        <input type="file" id="importFile" style="display:none" onchange="importData(event)">
    </div>

    <canvas id="compressCanvas" style="display:none;"></canvas>

    <script>
        let db;
        let tasks = [];
        let editingTaskId = null;
        let audioCtx = null;
        let alarmInterval = null;

        window.addEventListener('DOMContentLoaded', () => {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('alarmDate').value = today;
        });

        const request = indexedDB.open("TaskNoteManagerDB", 2);

        request.onerror = () => alert("डेटाबेस खोल्न सकिएन!");
        request.onsuccess = (e) => { db = e.target.result; loadTasks(); };
        request.onupgradeneeded = (e) => {
            let db = e.target.result;
            if (!db.objectStoreNames.contains("tasks")) {
                db.createObjectStore("tasks", { keyPath: "id", autoIncrement: true });
            }
        };

        function loadTasks() {
            if (!db) return;
            let transaction = db.transaction(["tasks"], "readonly");
            let store = transaction.objectStore("tasks");
            let request = store.getAll();

            request.onsuccess = (e) => {
                tasks = e.target.result || [];
                renderTasks();
            };
        }

        function saveTaskToDB(taskData, callback) {
            let transaction = db.transaction(["tasks"], "readwrite");
            let store = transaction.objectStore("tasks");
            let request;

            if (editingTaskId !== null) {
                taskData.id = editingTaskId;
                request = store.put(taskData);
            } else {
                request = store.add(taskData);
            }

            request.onsuccess = () => {
                editingTaskId = null;
                document.getElementById('saveTaskBtn').innerText = 'थप्नुहोस् (Add Task)';
                document.getElementById('formTitle').innerText = 'नयाँ काम थप्नुहोस्';
                clearTaskForm();
                loadTasks();
                if(callback) callback();
            };
        }

        function requestNotificationPermission() {
            if ("Notification" in window) {
                Notification.requestPermission().then(permission => {
                    if (permission === "granted") {
                        alert("नटिफिकेसन अनुमति सफल भयो!");
                    } else {
                        alert("नटिफिकेसन अनुमति अस्वीकार गरियो।");
                    }
                });
            }
        }

        function triggerLockScreenNotification(taskName) {
            if ("Notification" in window && Notification.permission === "granted") {
                try {
                    navigator.serviceWorker.ready.then(registration => {
                        registration.showNotification("🚨 अलार्म समय भयो!", {
                            body: `काम: ${taskName}`,
                            icon: "https://cdn-icons-png.flaticon.com/512/3236/3236946.png",
                            vibrate: [300, 100, 300, 100, 300],
                            tag: "alarm-alert",
                            renotify: true,
                            requireInteraction: true
                        });
                    });
                } catch(e) {
                    new Notification("🚨 अलार्म समय भयो!", { body: `काम: ${taskName}` });
                }
            }
        }

        function startAlarmSound() {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            if (alarmInterval) return;

            alarmInterval = setInterval(() => {
                try {
                    let osc = audioCtx.createOscillator();
                    let gain = audioCtx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(880, audioCtx.currentTime);
                    gain.gain.setValueAtTime(1, audioCtx.currentTime);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.5);
                } catch(e) {}
            }, 1000);
        }

        function stopAlarmSound() {
            if (alarmInterval) {
                clearInterval(alarmInterval);
                alarmInterval = null;
            }
        }

        function compressImage(file, callback) {
            const reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onload = (e) => {
                const img = new Image();
                img.src = e.target.result;
                img.onload = () => {
                    const canvas = document.getElementById('compressCanvas');
                    const ctx = canvas.getContext('2d');
                    let width = img.width, height = img.height;
                    const maxWidth = 350, maxHeight = 350;

                    if (width > height) {
                        if (width > maxWidth) { height *= maxWidth / width; width = maxWidth; }
                    } else {
                        if (height > maxHeight) { width *= maxHeight / height; height = maxHeight; }
                    }

                    canvas.width = width;
                    canvas.height = height;
                    ctx.drawImage(img, 0, 0, width, height);
                    callback(canvas.toDataURL('image/jpeg', 0.55));
                };
                img.onerror = () => callback(null);
            };
            reader.onerror = () => callback(null);
        }

        function saveTask() {
            const name = document.getElementById('taskInput').value.trim();
            const note = document.getElementById('taskNoteInput').value.trim();
            const dateVal = document.getElementById('alarmDate').value;
            const hourVal = parseInt(document.getElementById('alarmHour').value);
            const minVal = document.getElementById('alarmMinute').value;
            const ampmVal = document.getElementById('alarmAmPm').value;
            const fileEl = document.getElementById('fileInput');

            if (!name) { alert('कृपया कामको नाम लेख्नुहोस्!'); return; }

            let timeISO = "";
            if (dateVal) {
                let h24 = hourVal;
                if (ampmVal === "PM" && h24 < 12) h24 += 12;
                if (ampmVal === "AM" && h24 === 12) h24 = 0;
                let hStr = String(h24).padStart(2, '0');
                timeISO = `${dateVal}T${hStr}:${minVal}`;
            }

            const proceed = (fileData) => {
                let taskData = { name, note, time: timeISO, completed: false, triggered: false };
                if (fileData !== undefined) {
                    taskData.file = fileData;
                } else if (editingTaskId !== null) {
                    let existing = tasks.find(t => t.id === editingTaskId);
                    if (existing) taskData.file = existing.file;
                }
                saveTaskToDB(taskData);
            };

            if (fileEl.files && fileEl.files[0]) {
                compressImage(fileEl.files[0], (compressedBase64) => proceed(compressedBase64));
            } else {
                proceed(undefined);
            }
        }

        function clearTaskForm() {
            document.getElementById('taskInput').value = '';
            document.getElementById('taskNoteInput').value = '';
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('alarmDate').value = today;
            document.getElementById('alarmHour').value = "1";
            document.getElementById('alarmMinute').value = "00";
            document.getElementById('alarmAmPm').value = "AM";
            document.getElementById('fileInput').value = '';
        }

        function format12Hr(isoStr) {
            if (!isoStr) return 'राखिएको छैन';
            let d = new Date(isoStr);
            if (isNaN(d.getTime())) return isoStr;
            let hours = d.getHours();
            let minutes = String(d.getMinutes()).padStart(2, '0');
            let ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12 || 12;
            let dateStr = d.toLocaleDateString();
            return `${dateStr}, ${hours}:${minutes} ${ampm}`;
        }

        function toggleTask(id) {
            let task = tasks.find(t => t.id === id);
            if (task) {
                task.completed = !task.completed;
                let transaction = db.transaction(["tasks"], "readwrite");
                transaction.objectStore("tasks").put(task);
                renderTasks();
            }
        }

        function renderTasks() {
            const container = document.getElementById('taskList');
            container.innerHTML = '';

            if (!tasks || tasks.length === 0) {
                container.innerHTML = '<p style="color:#64748b; font-size:14px; text-align:center; padding:15px;">कुनै पनि काम थपिएको छैन।</p>';
                return;
            }

            tasks.forEach((t) => {
                const cardDiv = document.createElement('div');
                cardDiv.className = `visiting-card ${t.completed ? 'completed' : ''}`;
                
                let avatarHtml = t.file 
                    ? `<div class="avatar-box" onclick="window.open('${t.file}')" title="फोटो हेर्नुहोस्"><img src="${t.file}" class="avatar-img"></div>`
                    : `<div class="avatar-box"><span class="avatar-placeholder">👤</span></div>`;

                let noteHtml = t.note ? `<div class="card-note-text">📝 ${t.note}</div>` : '';
                let formattedTime = format12Hr(t.time);

                cardDiv.innerHTML = `
                    <div class="card-main">
                        ${avatarHtml}
                        <div class="card-details">
                            <div class="card-title-row">
                                <input type="checkbox" class="card-checkbox" ${t.completed ? 'checked' : ''} onchange="toggleTask(${t.id})">
                                <div class="card-title">${t.name}</div>
                            </div>
                            <div class="card-alarm">⏰ अलार्म: ${formattedTime}</div>
                            ${noteHtml}
                        </div>
                    </div>
                    <div class="card-actions">
                        <button class="action-btn btn-edit" onclick="editTask(${t.id})">✏️ इडिट</button>
                        <button class="action-btn btn-delete" onclick="deleteTask(${t.id})">🗑️ हटाउनुहोस्</button>
                    </div>
                `;
                container.appendChild(cardDiv);
            });
        }

        function editTask(id) {
            let t = tasks.find(item => item.id === id);
            if (!t) return;
            editingTaskId = id;
            document.getElementById('taskInput').value = t.name;
            document.getElementById('taskNoteInput').value = t.note || '';
            
            if (t.time) {
                let d = new Date(t.time);
                if (!isNaN(d.getTime())) {
                    document.getElementById('alarmDate').value = d.toISOString().split('T')[0];
                    let h24 = d.getHours();
                    let ampm = h24 >= 12 ? 'PM' : 'AM';
                    let h12 = h24 % 12 || 12;
                    document.getElementById('alarmHour').value = h12;
                    document.getElementById('alarmMinute').value = String(d.getMinutes()).padStart(2, '0');
                    document.getElementById('alarmAmPm').value = ampm;
                }
            }

            document.getElementById('saveTaskBtn').innerText = 'सेभ गर्नुहोस् (Update)';
            document.getElementById('formTitle').innerText = 'काम र समय इडिट गर्नुहोस्';
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function deleteTask(id) {
            if (confirm('के तपाईं यो काम हटाउन चाहनुहुन्छ?')) {
                let transaction = db.transaction(["tasks"], "readwrite");
                transaction.objectStore("tasks").delete(id).onsuccess = () => loadTasks();
            }
        }

        setInterval(() => {
            const now = new Date().getTime();
            tasks.forEach(t => {
                if (t.time && !t.triggered && !t.completed) {
                    if (now >= new Date(t.time).getTime()) {
                        t.triggered = true;
                        let transaction = db.transaction(["tasks"], "readwrite");
                        transaction.objectStore("tasks").put(t);

                        document.getElementById('alarmSubText').innerText = t.name;
                        document.getElementById('alarmAlert').style.display = 'block';
                        startAlarmSound();
                        triggerLockScreenNotification(t.name);
                    }
                }
            });
        }, 5000);

        function stopAlarm() {
            stopAlarmSource = false;
            stopAlarmSound();
            document.getElementById('alarmAlert').style.display = 'none';
        }

        function exportData() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify({ tasks }));
            const dl = document.createElement('a');
            dl.setAttribute("href", dataStr);
            dl.setAttribute("download", "visiting_card_backup.json");
            dl.click();
        }

        function importData(e) {
            const reader = new FileReader();
            reader.onload = (event) => {
                try {
                    const data = JSON.parse(event.target.result);
                    if (data.tasks && Array.isArray(data.tasks)) {
                        let transaction = db.transaction(["tasks"], "readwrite");
                        let store = transaction.objectStore("tasks");
                        store.clear();
                        data.tasks.forEach(t => store.add(t));
                        transaction.oncomplete = () => { loadTasks(); alert('डाटा सफलतापूर्वक लोड भयो!'); };
                    }
                } catch(err) { alert('गलत फाइल फर्म्याट!'); }
            };
            reader.readAsText(e.target.files[0]);
        }

        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('data:text/javascript,' + encodeURIComponent(`
                self.addEventListener('install', e => self.skipWaiting());
                self.addEventListener('activate', e => self.clients.claim());
            `)).catch(err => {});
        }
    </script>
</body>
</html>
